# ── 依赖与构建产物 ──
node_modules/
dist/
*.pdb
*.lib
*.exp

# ── 音源大文件：不进版本库 ──
# Yamaha Upright 原始 SoundFont（169MB，超过 GitHub 100MB 单文件上限）
# 88 个提取好的 wav 已在 assets/yup/wav/ 里，正常使用不需要 sf2
assets/yup/*.sf2
assets/yup/*.zip
# 旧的 mdaPiano 采样（已被 Yamaha 每键采样取代）
assets/wav/
assets/mdapiano-wavetable-raw.bin

# ── GM 多乐器 ──
# FluidR3Mono_GM.sf3（22MB）入库：它是所有非钢琴音色的唯一来源。
# 导出的 WAV 不入库：128 个乐器全导约 2.5GB，而且随时能用
#   python tools/extract_gm.py
# 从 sf3 重新生成。用户拿到仓库后跑一次就有。
assets/gm/out/
assets/gm/out-old/

# ── 运行时产物 ──
record/
*.log
tools/settings.json

# ── 编辑器 ──
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── 本地配置 ──
.env
.env.*

# 历史实现留档（piano-window.ps1 等），不进包
# 注意：保留在仓库里供参考，但 package.json 的 files 不含它
tools/archive/
