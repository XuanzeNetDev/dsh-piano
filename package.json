{
  "name": "dsh-piano-xz",
  "version": "2.2.0",
  "private": true,
  "description": "璇泽科技 · DSH 电脑钢琴：标准 88 键钢琴 + GM 128 音色，AI 用工具写谱/读 MIDI/切乐器/导出 WAV",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "assets/yup",
    "assets/piano",
    "assets/gm/*.sf3",
    "scores",
    "tools/sf2_parse.py",
    "tools/extract_gm.py",
    "tools/verify_gm.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "COMMERCIAL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "os": ["win32", "darwin", "linux"],
  "keywords": ["dsh", "dsh-plugin", "钢琴", "piano", "音乐", "midi", "general-midi", "乐器", "instruments", "soundfont"],
  "license": "SEE LICENSE IN LICENSE"
}
