# Flower Dance（花舞）—— DJ Okawari ｜ 第 1 页（原谱 1–20 小节）
#
# 照抄规则：
#   右手数字带高八度点 → 记 3' 2' 1' 7'（十六分跑动全是这样）
#   左手数字带低八度点 → 记 4, 1, 5, 6,
#   数字下的横线是时值：一条=八分、两条=十六分，用 :0.5 / :0.25 表示
#   1=B3 时：1=B3 2=C#4 3=D#4 4=E4 5=F#4 6=G#4 7=A#4

tempo 100
key 1=B3
dyn 70

[RH]
dyn 100
# ── (1)–(4) 十六分循环 3̇2̇ 6̇2̇ ─────────────────
unit 0.25
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'

# ── (5)–(8) 同上，(8) 收 3̇ 长音 ────────────────
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'
3':4

# ── (9) 3̇ + 琶音 36135 + 和弦(2̇+7) + 和弦(5̇+2̇+7) ──
unit 0.5
3':1 3':0.2 6':0.2 1':0.2 3':0.2 5':0.2 2'+7:1 5'+2'+7:1
# ── (10) 2̇. 7̲ ｜ 6̲.#̲5̲ ｜ 3̲ ｜ 3̲ ────────────────
2':0.75 7:0.25 6:0.75 #5:0.25 3:1 3:1
# ── (11) 6̲ + 和弦(3̇+6̲) ｜ 2̲ ｜ 2̲3̲2̲7̲5̲ ────────────
6:1 3'+6:1 2:1 2:0.2 3:0.2 2:0.2 7:0.2 5:0.2
# ── (12) 6̲ - - 0̲3̲ ─────────────────────────────
6:3 0:0.5 3:0.5

# ── (13) [琶音] 1̇ 7 2 ─────────────────────────
1':1 7 2:2
# ── (14) 2̇#5̇ 7 7 6 7 3127 1675 ────────────────
2':0.25 #5':0.25 7:0.25 7:0.25 6:0.25 7:0.25 3':0.25 1':0.25
2':0.25 7:0.25 1':0.25 6':0.25 7:0.25 5:0.25
# ── (15) 6323 6323 6323 6323 ───────────────────
unit 0.25
6' 3' 2' 3' 6' 3' 2' 3' 6' 3' 2' 3' 6' 3' 2' 3'
# ── (16) 6313 6313 6313 6 3 ────────────────────
6' 3' 1' 3' 6' 3' 1' 3' 6' 3' 1' 3' 6:0.5 3:0.25 3:0.25

# ── (17) 1373 1323 7767 5 35 ───────────────────
1' 3' 7' 3' 1' 3' 2' 3' 7' 7' 6' 7' 5:0.5 3:0.25 5:0.25
# ── (18) 6151 6111 5141 3 35 ───────────────────
6' 1' 5' 1' 6' 1' 1' 1' 5' 1' 4' 1' 3:0.5 3:0.25 5:0.25
# ── (19) 4636 2646 3323 1333 ───────────────────
4' 6' 3' 6' 2' 6' 4' 6' 3' 3' 2' 3' 1' 3' 3' 3'
# ── (20) 2414 7464 4 4 3 ───────────────────────
2' 4' 1' 4' 7' 4' 6' 4' 4:0.5 4:0.25 3:0.25

[LH]
dyn 70
# ── (1)–(4) 4̠1̠ 4̠5̠ 6̠ 0 ／ 5̠2̠ 5̠6̠ 7̠ 0 ／ 6̠3̠ 6̠7̠ 1̠̇ 0 ／ 空 ──
unit 0.5
4, 1, 4, 5, 6,:1 r:1
5, 2, 5, 6, 7,:1 r:1
6, 3, 6, 7, 1:1 r:1
r:4

# ── (5)–(8) 同上，(8) 收 6̠ ────────────────────
4, 1, 4, 5, 6,:1 r:1
5, 2, 5, 6, 7,:1 r:1
6, 3, 6, 7, 1:1 r:1
6,:4

# ── (9) 0 1̠ 0 5̠2̠ 5̠ ────────────────────────────
r:1 1,:1 r:1 5, 2, 5,
# ── (10) 3̠ 7̠ 3̠#̠5̠ 6̠3̠ 6̠3̠ ──────────────────────
3, 7, 3, #5, 6, 3, 6, 3,
# ── (11) 4̠1̠ 4̠1̠ 5̠2̠ 5̠2̠ ────────────────────────
4, 1, 4, 1, 5, 2, 5, 2,
# ── (12) 6̠3̠ 6̠7̠ 1̠̇3̠ 6̠ ────────────────────────
6, 3, 6, 7, 1, 3, 6, 3,

# ── (13) 4̠ 1̠ 0 5̠2̠ 5̠ ──────────────────────────
4, 1, r:1 5, 2, 5,
# ── (14) 3̠ 7̠ 3̠ 6̠3̠ 6̠ ─────────────────────────
3, 7, 3, 6, 3, 6,
# ── (15) 4̠1̠ 4̠ 5̠2̠ 5̠ ──────────────────────────
4, 1, 4, 5, 2, 5, 5, 2,
# ── (16) 6̠3̠ 6̠7̠ #̠1̇ 0 ─────────────────────────
6, 3, 6, 7, #1', r:2

# ── (17) 6367 1̠ 3̠ 3̠ 7̠ 3̠ ──────────────────────
unit 0.25
6, 3, 6, 7, 1, 3, 3, 7, 3,
# ── (18) 4145 6̠ 1̠ 1̠ 5̠ 1̠ ──────────────────────
4, 1, 4, 5, 6, 1, 1, 5, 1,
# ── (19) 2̠ 6̠ 4321 6̠ 3̠ 3217 ───────────────────
2, 6, 4, 3, 2, 1, 6, 3, 3, 2, 1, 7,
# ── (20) 7̠ 4̠ 7̠ 4̠ 2̠ 1̠ 7̠ 3̠ ────────────────────
7, 4, 7, 4, 2, 1, 7, 3,
