# Flower Dance（花舞）—— DJ Okawari
# 逐小节转写。1=B3、4/4、♩=100。
#
# 三条关键记号（前几版全读错了）：
#   1. 右手 3̇2̇ 6̇2̇ 是**十六分音符对**，一小节 16 个音
#   2. 右手全部带高八度点 → 3' 2' 6' 2'
#   3. 左手全部带低八度点 → 4, 1, 4, 5, 6,

tempo 100
key 1=B3
unit 0.25
dyn 0.72

[RH]
# ── (1)-(4) 十六分循环，每行一小节 ──────────────
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'

# ── (5)-(7) 同上，(8) 收长音 ────────────────────
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'
3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2' 3' 2' 6' 2'
3' - - - - - - - - - - - - - - - -

# ── 主题 A（9-12）：3̇ → 2̇7̲ → 2̇. 7̲ 6̲.#̲5̲ 3̲ → 6̲ → 6̲ ────
unit 0.5
3':2 2':1 7:1
2':1.5 7:0.5 6:1 #5:1
6:2 2:1 3:1
6:4

[LH]
unit 0.5
# (1)-(4) 4̠1̠ 4̠5̠ 6̠ 0 ／ 5̠2̠ 5̠6̠ 7̠ 0 ／ 6̠3̠ 6̠7̠ 1 0 ／ 空
4, 1, 4, 5, 6,:1 r:1
5, 2, 5, 6, 7,:1 r:1
6, 3, 6, 7, 1:1 r:1
r:4

# (5)-(7) 同上，(8) 收在 6̠
4, 1, 4, 5, 6,:1 r:1
5, 2, 5, 6, 7,:1 r:1
6, 3, 6, 7, 1:1 r:1
6,:4

# (9)-(10) 0 1̠ 0 5̠2̠ 5̠ ／ 3̠ 7̠ 3̠#̠5̠ 6̠3̠ 6̠3̠
r:1 1,:1 r:1 5, 2, 5,
3, 7, 3, #5, 6, 3, 6, 3,

# (11)-(12) 4̠1̠ 4̠1̠ 5̠2̠ 5̠2̠ ／ 6̠3̠ 6̠7̠ 1̠3̠ 6̠
4, 1, 4, 1, 5, 2, 5, 2,
6, 3, 6, 7, 1, 3, 6, 3,
